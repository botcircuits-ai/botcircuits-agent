{
  "name": "workflow_demo",
  "description": "Creates markdown files step_1.md..step_10.md with step number and current date/time; can terminate early when end_id matches the current step id; always writes end.md at the end.",
  "flow": {
    "start": "start",
    "steps": {
      "start": {
        "type": "start",
        "next": "step_1"
      },
      "step_1": {
        "type": "agentAction",
        "settings": {
          "action": "Create a markdown file named step_1.md in the current directory containing the current step number and current date and time, e.g., with content: Step 1 — <current date and time>."
        },
        "conditions": [
          {
            "condition": "end_id equals 'step_1'",
            "next": "end",
            "expCondition": "end_id is 'step_1'"
          },
          {
            "condition": "end_id does not equal 'step_1'",
            "next": "step_2",
            "expCondition": "end_id is not 'step_1'"
          }
        ],
        "choices": [
          {
            "operator": "AND",
            "expressionList": [
              {
                "variable": "end_id",
                "operator": "is",
                "value": "step_1"
              }
            ],
            "next": "end"
          },
          {
            "operator": "AND",
            "expressionList": [
              {
                "variable": "end_id",
                "operator": "is not",
                "value": "step_1"
              }
            ],
            "next": "step_2"
          }
        ]
      },
