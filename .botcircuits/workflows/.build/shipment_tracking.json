{
  "name": "shipment_tracking",
  "description": "Unattended batch check of many parcels: read a list of tracking numbers from a text file, look each one up against the carrier API, classify every parcel deterministically (delivered / out_for_delivery / in_transit / delayed / escalate / not_found / error), and write a single dated results file with a per-outcome summary. Never asks the user anything.",
  "flow": {
    "start": "start",
    "variables": [
      {
        "variableName": "tracking_file",
        "description": "Path to the plain-text file of tracking numbers, one per line. Default examples/shipment_tracking/tracking-ids.txt. To change the input file, edit this and the classify step's itemSource.file.",
        "dataType": "string",
        "default": "examples/shipment_tracking/tracking-ids.txt"
      },
      {
        "variableName": "results",
        "description": "The list of decided records collected by the classify step, one per tracking number.",
        "dataType": "string"
      },
      {
        "variableName": "lookup_failed",
        "dataType": "boolean",
        "description": "True when the carrier lookup failed: a non-200 response, an empty body, a timeout, or a connection/exec error."
      },
      {
        "variableName": "not_found",
        "dataType": "boolean",
        "description": "True when the carrier reports the tracking number is not found / invalid (HTTP 404)."
      },
      {
        "variableName": "status",
        "dataType": "string",
        "description": "The carrier status string, e.g. delivered, out for delivery, in transit, exception, returned, lost."
      },
      {
        "variableName": "is_delayed",
        "dataType": "boolean",
        "description": "True when the parcel is in transit AND its estimated delivery is more than the threshold (7) days away."
      }
    ],
    "steps": {
      "start": {
        "type": "start",
        "next": "classify"
      },
      "classify": {
        "type": "listDecision",
        "settings": {
          "action": "For each tracking number in the input file, query carrier live status and set outcome from gathered facts only. No invented statuses."
        },
        "itemSource": {
          "file": "examples/shipment_tracking/tracking-ids.txt",
          "path": ""
        },
        "itemFacts": {
          "kind": "exec",
          "command": [
            "python3",
            "examples/shipment_tracking/bin/track.py",
            "--host",
            "http://localhost:4000/v1",
            "--threshold",
            "7",
            "{value}"
          ],
          "parse": "json",
          "derive": {
            "tracking_number": {
              "from_item": "value"
            },
            "lookup_failed": {
              "from_output": "lookup_failed",
              "default": true
            },
            "not_found": {
              "from_output": "not_found",
              "default": false
            },
            "status": {
              "from_output": "status",
              "default": ""
            },
            "last_location": {
              "from_output": "last_location",
              "default": ""
            },
            "estimated_delivery": {
              "from_output": "estimated_delivery",
              "default": ""
            },
            "days_until_delivery": {
              "from_output": "days_until_delivery",
              "default": 0
            },
            "is_delayed": {
              "from_output": "is_delayed",
              "default": false
            },
            "needs_attention": {
              "from_output": "needs_attention",
              "default": false
            },
            "note": {
              "from_output": "note",
              "default": ""
            }
          }
        },
        "itemVariables": [
          {
            "variableName": "tracking_number",
            "description": "The parcel's tracking number.",
            "dataType": "string"
          },
          {
            "variableName": "lookup_failed",
            "description": "True when the carrier lookup failed: a non-200 response, an empty body, a timeout, or a connection/exec error.",
            "dataType": "boolean"
          },
          {
            "variableName": "not_found",
            "description": "True when the carrier reports the tracking number is not found / invalid (HTTP 404).",
            "dataType": "boolean"
          },
          {
            "variableName": "status",
            "description": "The carrier status string, e.g. delivered, out for delivery, in transit, exception, returned, lost.",
            "dataType": "string"
          },
          {
            "variableName": "last_location",
            "description": "The parcel's last known location.",
            "dataType": "string"
          },
          {
            "variableName": "estimated_delivery",
            "description": "The carrier's estimated delivery date (YYYY-MM-DD), or empty.",
            "dataType": "string"
          },
          {
            "variableName": "days_until_delivery",
            "description": "Whole days from today until the estimated delivery date (0 when unknown).",
            "dataType": "number"
          },
          {
            "variableName": "is_delayed",
            "description": "True when the parcel is in transit AND its estimated delivery is more than the threshold (7) days away. Precomputed deterministically so the delayed branch is a simple boolean test.",
            "dataType": "boolean"
          },
          {
            "variableName": "needs_attention",
            "description": "True for delayed and escalate parcels (in transit and more than 7 days away, or exception/returned/lost).",
            "dataType": "boolean"
          },
          {
            "variableName": "note",
            "description": "Short human-readable summary of the parcel's facts.",
            "dataType": "string"
          }
        ],
        "conditions": [
          {
            "condition": "the carrier lookup failed",
            "next": "error",
            "expCondition": "lookup_failed is true"
          },
          {
            "condition": "the tracking number was not found",
            "next": "not_found",
            "expCondition": "not_found is true"
          },
          {
            "condition": "the status is delivered",
            "next": "delivered",
            "expCondition": "status is 'delivered'"
          },
          {
            "condition": "the status is out for delivery",
            "next": "out_for_delivery",
            "expCondition": "status is 'out for delivery'"
          },
          {
            "condition": "the parcel is delayed",
            "next": "delayed",
            "expCondition": "is_delayed is true"
          },
          {
            "condition": "the status is in transit",
            "next": "in_transit",
            "expCondition": "status is 'in transit'"
          },
          {
            "condition": "the status is exception",
            "next": "escalate",
            "expCondition": "status is 'exception'"
          },
          {
            "condition": "the status is returned",
            "next": "escalate",
            "expCondition": "status is 'returned'"
          },
          {
            "condition": "the status is lost",
            "next": "escalate",
            "expCondition": "status is 'lost'"
          }
        ],
        "decisionKey": "outcome",
        "collectInto": "results",
        "emit": [
          "tracking_number",
          "status",
          "last_location",
          "estimated_delivery",
          "note",
          "needs_attention"
        ],
        "defaultNext": "in_transit",
        "next": "save_results",
        "choices": [
          {
            "operator": "AND",
            "expressionList": [
              {
                "variable": "lookup_failed",
                "operator": "is",
                "value": true
              }
            ],
            "next": "error"
          },
          {
            "operator": "AND",
            "expressionList": [
              {
                "variable": "not_found",
                "operator": "is",
                "value": true
              }
            ],
            "next": "not_found"
          },
          {
            "operator": "AND",
            "expressionList": [
              {
                "variable": "status",
                "operator": "is",
                "value": "delivered"
              }
            ],
            "next": "delivered"
          },
          {
            "operator": "AND",
            "expressionList": [
              {
                "variable": "status",
                "operator": "is",
                "value": "out for delivery"
              }
            ],
            "next": "out_for_delivery"
          },
          {
            "operator": "AND",
            "expressionList": [
              {
                "variable": "is_delayed",
                "operator": "is",
                "value": true
              }
            ],
            "next": "delayed"
          },
          {
            "operator": "AND",
            "expressionList": [
              {
                "variable": "status",
                "operator": "is",
                "value": "in transit"
              }
            ],
            "next": "in_transit"
          },
          {
            "operator": "AND",
            "expressionList": [
              {
                "variable": "status",
                "operator": "is",
                "value": "exception"
              }
            ],
            "next": "escalate"
          },
          {
            "operator": "AND",
            "expressionList": [
              {
                "variable": "status",
                "operator": "is",
                "value": "returned"
              }
            ],
            "next": "escalate"
          },
          {
            "operator": "AND",
            "expressionList": [
              {
                "variable": "status",
                "operator": "is",
                "value": "lost"
              }
            ],
            "next": "escalate"
          }
        ],
        "nullOn": {}
      },
      "save_results": {
        "type": "agentAction",
        "settings": {
          "action": "Write {results} unchanged as JSON to tracking-status-<TODAY>.json (<TODAY>=today YYYY-MM-DD). Object: `summary` first with `total` (record count) and `by_outcome` (counts grouped by `outcome`), then `results` holding the full decided record list. End flow."
        }
      }
    },
    "result": {
      "kind": "template",
      "value": {
        "results": "{results}"
      }
    },
    "segments": [
      {
        "id": "start",
        "steps": [
          "classify"
        ],
        "branchStep": "classify"
      },
      {
        "id": "save_results",
        "steps": [
          "save_results"
        ],
        "branchStep": null
      }
    ]
  }
}
